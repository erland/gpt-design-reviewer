{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Platform-neutral Workspace and State Contract",
  "type": "object",
  "required": ["contract_version", "workspace", "state"],
  "properties": {
    "contract_version": {"type": "integer", "const": 1},
    "schema": {"type": "string", "minLength": 1},
    "workspace": {
      "type": "object",
      "required": ["requirement", "persistence", "portable", "separate_from_assistant"],
      "properties": {
        "requirement": {"enum": ["required", "recommended", "optional", "not_required"]},
        "persistence": {"enum": ["required", "preferred", "ephemeral", "not_required"]},
        "portable": {"type": "boolean"},
        "separate_from_assistant": {"type": "boolean"},
        "artifact": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "required": ["requirement", "persistence", "authority"],
      "properties": {
        "requirement": {"enum": ["required", "recommended", "optional", "not_required"]},
        "persistence": {"enum": ["required", "preferred", "ephemeral", "not_required"]},
        "authority": {"enum": ["workspace_file", "conversation", "runtime_managed", "none"]},
        "format": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "conversation_fallback": {"type": "boolean"},
        "description": {"type": "string"}
      },
      "allOf": [{
        "if": {"properties": {"authority": {"const": "workspace_file"}}, "required": ["authority"]},
        "then": {"required": ["format", "path"]}
      }],
      "additionalProperties": false
    },
    "analysis_state": {
      "type": "object",
      "required": ["incremental", "checkpoint_policy", "resume_command", "required_sections"],
      "properties": {
        "incremental": {"type": "boolean"},
        "checkpoint_policy": {"enum": ["after_each_analysis_step", "after_material_change", "runtime_managed"]},
        "resume_command": {"type": "string", "minLength": 1},
        "required_sections": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "runtime_preferences": {
      "type": "object",
      "additionalProperties": {"enum": ["workspace_file", "conversation_or_file", "runtime_managed", "none"]}
    }
  },
  "additionalProperties": false
}
