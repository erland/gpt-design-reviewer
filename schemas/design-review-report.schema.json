{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design Reviewer report contract",
  "type": "object",
  "required": ["contract_version", "artifact", "principles", "sections", "observation_rendering", "handoff"],
  "properties": {
    "contract_version": {"type": "integer", "const": 1},
    "artifact": {
      "type": "object",
      "required": ["id", "filename", "format", "purpose"],
      "properties": {
        "id": {"const": "design_review"},
        "filename": {"const": "design-review.md"},
        "format": {"const": "markdown"},
        "purpose": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "principles": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 1}},
    "sections": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "heading", "required"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "heading": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "content": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "repeat_for_each_observation": {"type": "boolean"},
          "observation_fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "rule": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "observation_rendering": {
      "type": "object",
      "required": ["heading_pattern", "required_labels", "optional_labels"],
      "properties": {
        "heading_pattern": {"type": "string", "minLength": 1},
        "required_labels": {"type": "array", "minItems": 10, "items": {"type": "string", "minLength": 1}},
        "optional_labels": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "handoff": {
      "type": "object",
      "required": ["next_artifact", "required_inputs", "forbidden_outputs"],
      "properties": {
        "next_artifact": {"const": "recommended-solution-strategy.md"},
        "required_inputs": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
        "forbidden_outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
