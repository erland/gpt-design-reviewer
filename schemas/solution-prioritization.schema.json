{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design Reviewer solution prioritization contract",
  "type": "object",
  "required": [
    "contract_version", "purpose", "inputs", "eligibility", "strategy_units",
    "priority_dimensions", "ordering_model", "priority_bands", "tradeoff_rules",
    "requirement_and_ux_alternatives", "strategy_output_model", "forbidden_shortcuts"
  ],
  "properties": {
    "contract_version": {"type": "integer", "const": 1},
    "purpose": {"type": "string", "minLength": 20},
    "inputs": {"type": "object", "required": ["required", "optional"]},
    "eligibility": {"type": "object", "required": ["rules"]},
    "strategy_units": {"type": "object", "required": ["remediation_theme", "validation_action", "product_or_ux_alternative"]},
    "priority_dimensions": {
      "type": "object",
      "required": ["benefit", "confidence", "cost", "risk", "enabling_effect", "urgency"]
    },
    "ordering_model": {
      "type": "object",
      "required": ["type", "numeric_score_required", "stages"],
      "properties": {
        "type": {"const": "constrained_qualitative_ordering"},
        "numeric_score_required": {"const": false},
        "stages": {"type": "array", "minItems": 5}
      }
    },
    "priority_bands": {"type": "array", "minItems": 5},
    "tradeoff_rules": {"type": "array", "minItems": 1},
    "requirement_and_ux_alternatives": {"type": "object", "required": ["allowed", "rules"]},
    "strategy_output_model": {"type": "object", "required": ["required_sections", "prioritized_theme_fields", "traceability"]},
    "forbidden_shortcuts": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
