{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design Reviewer analysis workflow contract",
  "type": "object",
  "required": ["contract_version", "workflow", "stages", "hotspot_selection", "progressive_analysis", "checkpointing", "resume", "coverage_and_bias_controls"],
  "properties": {
    "contract_version": {"type": "integer", "const": 1},
    "workflow": {
      "type": "object",
      "required": ["objective", "modes", "mode_selection"],
      "properties": {
        "objective": {"type": "string", "minLength": 1},
        "modes": {
          "type": "object",
          "required": ["focused", "progressive"],
          "properties": {
            "focused": {"type": "object"},
            "progressive": {"type": "object"}
          },
          "additionalProperties": false
        },
        "mode_selection": {"type": "object"}
      },
      "additionalProperties": false
    },
    "stages": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["id", "order", "purpose", "required_outputs", "completion_criteria"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "order": {"type": "integer", "minimum": 1},
          "purpose": {"type": "string", "minLength": 1},
          "repeatable": {"type": "boolean"},
          "required_outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "completion_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "hotspot_selection": {"type": "object", "required": ["goal", "signals", "counter_signals", "queue_fields", "ordering_principles"]},
    "progressive_analysis": {"type": "object", "required": ["analysis_unit", "continuation_decision", "stop_conditions"]},
    "checkpointing": {"type": "object", "required": ["policy", "minimum_state", "checkpoint_quality_rules"]},
    "resume": {"type": "object", "required": ["command", "behavior", "invalidation_rules"]},
    "coverage_and_bias_controls": {"type": "object", "required": ["principles"]}
  },
  "additionalProperties": false
}
